{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "default_locale": "en",
  "author": "Jan Pňakovič",
  "version": "2026.11.9",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "alza-price-insight@pnakovic",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://www.alza.cz/*", "https://www.alza.sk/*", "https://www.alza.hu/*", "https://image.alza.cz/*", "https://image.alza.sk/*", "https://image.alza.hu/*"],
  "background": {
    "service_worker": "src/chrome/service-worker.js",
    "scripts": ["src/shared/core.js", "src/shared/store.js", "src/shared/product-page.js", "src/firefox/product-pages.js", "src/background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.alza.cz/*",
        "https://www.alza.sk/*",
        "https://www.alza.hu/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/icons.js",
        "src/shared/store.js",
        "src/content/texts.js",
        "src/content.js",
        "src/content/variants.js",
        "src/content/cart-warning.js",
        "src/content/price-card.js",
        "src/content/basket-codes.js",
        "src/content/basket-insights.js",
        "src/content/history.js",
        "src/content/targets.js",
        "src/content/list-toolbar.js",
        "src/content/insights.js",
        "src/content/history-chart.js",
        "src/content/product-panel.js",
        "src/content/watch.js",
        "src/content/start.js",
        "src/category.js",
        "src/browsing.js",
        "src/purchases.js"
      ],
      "css": ["css/main.css"]
    }
  ],
  "icons": {
    "16": "img/icon-16.png",
    "32": "img/icon-32.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
